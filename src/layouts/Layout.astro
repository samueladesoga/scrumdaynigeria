---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const site = await getEntry('site', 'config');
if (!site) throw new Error('Missing site config entry (src/content/site.yaml)');

const { title, description = site.data.tagline, image } = Astro.props;
const pageTitle = title ? `${title} — ${site.data.eventName}` : site.data.eventName;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={site.data.eventName} href="/rss.xml" />
  </head>
  <body>
    <Header nav={site.data.nav} eventName={site.data.eventName} ticketUrl={site.data.ticketUrl} />
    <slot />
    <Footer site={site.data} />
  </body>
</html>
