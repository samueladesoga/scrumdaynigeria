---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const site = await getEntry('site', 'config');
if (!site) throw new Error('Missing site config entry (src/content/site.yaml)');

const { title, description = site.data.tagline, image } = Astro.props;
const pageTitle = title ? `${title} — ${site.data.eventName}` : site.data.eventName;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#f15b30" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={site.data.eventName} href="/rss.xml" />
  </head>
  <body>
    <slot />
    <Footer site={site.data} />
  </body>
</html>
