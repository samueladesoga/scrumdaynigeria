---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const articles = (await getCollection('press')).sort((a, b) => a.data.order - b.data.order);
---

{articles.length > 0 && (
  <section class="press-section" id="press" aria-labelledby="press-title">
    <div class="container">
      <p class="press-kicker">Coverage of our last edition</p>
      <h2 id="press-title" class="press-title">Scrum Day Nigeria in the News</h2>

      <ul class="press-grid" role="list">
        {articles.map((article) => (
          <li>
            <a class="press-card" href={article.data.url} target="_blank" rel="noopener noreferrer">
              <span class="press-thumb">
                <Image
                  src={article.data.image}
                  alt=""
                  width={640}
                  widths={[320, 640]}
                  sizes="(max-width: 600px) 82vw, (max-width: 960px) 46vw, 270px"
                  format="webp"
                  quality={72}
                />
              </span>
              <span class="press-headline">{article.data.headline}</span>
              <span class="press-read">
                Read full article on <span class="press-outlet">{article.data.outlet}&nbsp;<span aria-hidden="true">↗</span></span>
                <span class="sr-only">(opens in a new tab)</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
.press-section {
  background-color: #082f33;
  background-image: linear-gradient(180deg, #082f33 0%, #0a3438 100%);
  padding: 4.5rem 0;
  color: #ffffff;
}

.press-kicker {
  margin: 0 0 0.75rem;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 0.85rem;
  font-weight: 700;
  color: #9fc3c6;
}

.press-title {
  margin: 0 0 2.4rem;
  text-align: center;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: clamp(1.8rem, 3.2vw, 2.7rem);
  line-height: 1.04;
  letter-spacing: -0.018em;
}

.press-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1.25rem;
}

.press-grid li {
  display: flex;
}

.press-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  border-radius: 14px;
  overflow: hidden;
  background: #ffffff;
  color: #131a20;
  text-decoration: none;
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.22);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.press-card:hover,
.press-card:focus-visible {
  transform: translateY(-3px);
  box-shadow: 0 14px 32px rgba(0, 0, 0, 0.32);
}

.press-card:focus-visible {
  outline: 2px solid #9fc3c6;
  outline-offset: 3px;
}

.press-thumb {
  display: block;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: #dfe6e7;
}

.press-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.press-card:hover .press-thumb img {
  transform: scale(1.04);
}

.press-headline {
  flex: 1;
  padding: 1rem 1.1rem 0.6rem;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: 1.02rem;
  font-weight: 600;
  line-height: 1.4;
}

.press-read {
  padding: 0 1.1rem 1.1rem;
  font-size: 0.88rem;
  font-weight: 700;
  color: #0e494f;
}

.press-outlet {
  white-space: nowrap;
}

.press-card:hover .press-read {
  text-decoration: underline;
}

@media (max-width: 960px) {
  .press-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Phones: a swipeable row instead of a tall stack of four cards. */
@media (max-width: 600px) {
  .press-section {
    padding: 3.5rem 0;
  }

  .press-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
  }

  .press-grid li {
    flex: 0 0 82%;
    scroll-snap-align: start;
  }
}

@media (prefers-reduced-motion: reduce) {
  .press-card,
  .press-thumb img {
    transition: none;
  }

  .press-card:hover,
  .press-card:focus-visible,
  .press-card:hover .press-thumb img {
    transform: none;
  }
}
</style>
