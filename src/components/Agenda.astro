---
import { getCollection, getEntry } from 'astro:content';

interface Props {
  showViewAll?: boolean;
}

const { showViewAll = false } = Astro.props;

const items = (await getCollection('agenda')).sort((a, b) => {
  if (a.data.day !== b.data.day) return a.data.day.localeCompare(b.data.day);
  return a.data.startTime.localeCompare(b.data.startTime);
});

const days = [...new Set(items.map((item) => item.data.day))];

const speakerNames = new Map<string, string>();
for (const item of items) {
  for (const id of item.data.speakerIds) {
    if (speakerNames.has(id)) continue;
    const speaker = await getEntry('speakers', id);
    if (speaker) speakerNames.set(id, speaker.data.name);
  }
}
---

<section id="schedule" class="mx-auto max-w-4xl px-6 py-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent">Schedule</p>
      <h2 class="mt-3 text-3xl font-bold text-ink sm:text-4xl">Event Agenda</h2>
    </div>
    {showViewAll && (
      <a href="/schedule" class="text-sm font-semibold text-accent hover:underline">Full schedule &rarr;</a>
    )}
  </div>

  {days.map((day) => {
    const dayItems = items.filter((item) => item.data.day === day);
    return (
      <div class="mt-10">
        <h3 class="text-lg font-semibold text-ink">{dayItems[0].data.dayLabel}</h3>
        <ol class="mt-4 divide-y divide-border rounded-2xl border border-border bg-bg-card">
          {dayItems.map((item) => (
            <li class="flex flex-col gap-1 px-6 py-4 sm:flex-row sm:items-baseline sm:gap-6">
              <span class="w-32 shrink-0 text-sm font-medium text-accent">
                {item.data.startTime}{item.data.endTime ? `–${item.data.endTime}` : ''}
              </span>
              <div>
                <p class="font-semibold text-ink">{item.data.title}</p>
                {item.data.description && <p class="mt-1 text-sm text-ink-muted">{item.data.description}</p>}
                {item.data.speakerIds.length > 0 && (
                  <p class="mt-1 text-sm text-ink-muted">
                    {item.data.speakerIds.map((id) => speakerNames.get(id)).filter(Boolean).join(', ')}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    );
  })}
</section>
