---
import { getCollection, getEntry } from 'astro:content';

interface Props {
  showViewAll?: boolean;
}

const { showViewAll = false } = Astro.props;

const items = (await getCollection('agenda')).sort((a, b) => {
  if (a.data.day !== b.data.day) return a.data.day.localeCompare(b.data.day);
  return a.data.startTime.localeCompare(b.data.startTime);
});

const days = [...new Set(items.map((item) => item.data.day))];

const speakerNames = new Map<string, string>();
for (const item of items) {
  for (const id of item.data.speakerIds) {
    if (speakerNames.has(id)) continue;
    const speaker = await getEntry('speakers', id);
    if (speaker) speakerNames.set(id, speaker.data.name);
  }
}
---

<section id="schedule" class="agenda-section container">
  <div class="agenda-head">
    <div>
      <p class="eyebrow">Schedule</p>
      <h2>Event Agenda</h2>
    </div>
    {showViewAll && <a href="/schedule" class="view-all">Full schedule &rarr;</a>}
  </div>

  {days.map((day) => {
    const dayItems = items.filter((item) => item.data.day === day);
    return (
      <div class="day-block">
        <h3>{dayItems[0].data.dayLabel}</h3>
        <ol class="agenda-list">
          {dayItems.map((item) => (
            <li>
              <span class="time">
                {item.data.startTime}{item.data.endTime ? `–${item.data.endTime}` : ''}
              </span>
              <div>
                <p class="title">{item.data.title}</p>
                {item.data.description && <p class="desc">{item.data.description}</p>}
                {item.data.speakerIds.length > 0 && (
                  <p class="desc">
                    {item.data.speakerIds.map((id) => speakerNames.get(id)).filter(Boolean).join(', ')}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    );
  })}
</section>

<style>
.agenda-section {
  padding: 4rem 0;
}

.agenda-head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--brand-primary, #f15b30);
}

.agenda-head h2 {
  margin: 0.4rem 0 0;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: clamp(1.8rem, 3.4vw, 2.6rem);
  color: #1f2429;
}

.view-all {
  font-weight: 700;
  color: var(--brand-primary, #f15b30);
  text-decoration: none;
}

.day-block {
  margin-top: 2.4rem;
}

.day-block h3 {
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: 1.2rem;
  color: #1f2429;
  margin: 0 0 0.8rem;
}

.agenda-list {
  list-style: none;
  margin: 0;
  padding: 0;
  border: 1px solid #e6e6e6;
  border-radius: 16px;
  background: #ffffff;
  overflow: hidden;
}

.agenda-list li {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1rem 1.4rem;
  border-bottom: 1px solid #e6e6e6;
}

.agenda-list li:last-child {
  border-bottom: none;
}

@media (min-width: 640px) {
  .agenda-list li {
    flex-direction: row;
    align-items: baseline;
    gap: 1.4rem;
  }
}

.time {
  flex: 0 0 8rem;
  font-weight: 700;
  color: var(--brand-primary, #f15b30);
  font-size: 0.92rem;
}

.title {
  margin: 0;
  font-weight: 700;
  color: #1f2429;
}

.desc {
  margin: 0.25rem 0 0;
  color: #6a5f57;
  font-size: 0.92rem;
}
</style>
