---
interface Props {
  metrics: { days: string; expectedParticipants: string; speakers: string };
}

const { metrics } = Astro.props;

const items = [
  { label: 'Packed Day', value: metrics.days },
  { label: 'Expected Participants', value: metrics.expectedParticipants },
  { label: 'World-Class Speakers', value: metrics.speakers },
];
---

<section class="border-y border-border bg-bg-raised">
  <div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 px-6 py-10 text-center sm:grid-cols-3">
    {items.map((item) => (
      <div>
        <p class="text-4xl font-bold text-accent">{item.value}</p>
        <p class="mt-1 text-sm text-ink-muted">{item.label}</p>
      </div>
    ))}
  </div>
</section>
