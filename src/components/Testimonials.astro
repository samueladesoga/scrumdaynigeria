---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(testimonials.map((t) => render(t)));
---

{testimonials.length > 0 && (
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-accent">What People Say</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t, i) => {
        const { Content } = rendered[i];
        return (
          <figure class="rounded-2xl border border-border bg-bg-card p-6">
            <blockquote class="text-ink-muted">
              <Content />
            </blockquote>
            <figcaption class="mt-4 flex items-center gap-3">
              {t.data.image && (
                <Image src={t.data.image} alt={t.data.name} width={40} height={40} class="h-10 w-10 rounded-full object-cover" />
              )}
              <div>
                <p class="text-sm font-semibold text-ink">{t.data.name}</p>
                <p class="text-xs text-ink-muted">{t.data.role}{t.data.company ? `, ${t.data.company}` : ''}</p>
              </div>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>
)}
