---
interface Props {
  eventName: string;
  theme: string;
  tagline: string;
  displayDate: string;
  displayTime: string;
  venueName: string;
  venueAddress: string;
  ticketUrl: string;
}

const { theme, tagline, displayDate, displayTime, venueName, venueAddress, ticketUrl } = Astro.props;
---

<section class="relative overflow-hidden px-6 pb-20 pt-24 text-center">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--color-accent-soft)_0%,_transparent_60%)] opacity-40"></div>

  <p class="mx-auto max-w-2xl text-sm font-semibold uppercase tracking-[0.3em] text-accent">
    {displayDate} &middot; {displayTime}
  </p>

  <h1 class="mx-auto mt-6 max-w-4xl text-balance text-4xl font-bold leading-tight text-ink sm:text-6xl">
    {theme}
  </h1>

  <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
    {tagline}
  </p>

  <p class="mt-4 text-sm text-ink-muted">{venueName}, {venueAddress}</p>

  <div class="mt-10 flex justify-center gap-4">
    <a
      href={ticketUrl}
      class="rounded-full bg-accent px-8 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
    >
      Buy Ticket
    </a>
    <a
      href="#about"
      class="rounded-full border border-border px-8 py-3 text-sm font-semibold text-ink transition-colors hover:border-accent"
    >
      Learn More
    </a>
  </div>
</section>
