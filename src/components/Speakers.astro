---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  limit?: number;
  showViewAll?: boolean;
}

const { limit, showViewAll = false } = Astro.props;

let speakers = (await getCollection('speakers')).sort((a, b) => a.data.order - b.data.order);
if (limit) speakers = speakers.slice(0, limit);
---

<section id="speakers" class="mx-auto max-w-6xl px-6 py-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent">Speakers</p>
      <h2 class="mt-3 text-3xl font-bold text-ink sm:text-4xl">Meet this year's lineup</h2>
    </div>
    {showViewAll && (
      <a href="/speakers" class="text-sm font-semibold text-accent hover:underline">View all speakers &rarr;</a>
    )}
  </div>

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {speakers.map((speaker) => (
      <div class="group text-left">
        <div class="overflow-hidden rounded-2xl border border-border bg-bg-card">
          <Image
            src={speaker.data.image}
            alt={speaker.data.name}
            width={400}
            height={400}
            class="aspect-square w-full object-cover"
          />
        </div>
        <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-accent">
          {speaker.data.type}
        </p>
        <h3 class="mt-1 text-lg font-semibold text-ink">{speaker.data.name}</h3>
        <p class="text-sm text-ink-muted">{speaker.data.role}, {speaker.data.company}</p>
      </div>
    ))}
  </div>
</section>
