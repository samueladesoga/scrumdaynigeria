---
import { getCollection } from 'astro:content';

const tracks = (await getCollection('learningTracks')).sort((a, b) => a.data.order - b.data.order);
---

<section class="focus-areas" id="focus-areas" aria-labelledby="focus-areas-title">
  <div class="container focus-wrap">
    <div class="section-head">
      <span class="focus-kicker">This Year's Theme</span>
      <h2 id="focus-areas-title">Six Focus Areas<br />Shaping The Program</h2>
      <p>
        Every talk at Scrum Day Nigeria is shortlisted against one of these areas. If you're attending, it's a preview of what you'll hear. If you're speaking, it's where your proposal should land.
      </p>
    </div>

    <ul class="track-grid" role="list">
      {tracks.map((track, index) => (
        <li class="track-card">
          <span class="track-index">{String(index + 1).padStart(2, '0')}</span>
          <h3>{track.data.title}</h3>
          <p>{track.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.focus-areas {
  background: #ffffff;
  position: relative;
  padding: 5rem 0 5.4rem;
}

.focus-wrap {
  width: min(1220px, 94%);
}

.section-head {
  max-width: 760px;
  margin-bottom: 2.6rem;
}

.focus-kicker {
  display: inline-block;
  text-transform: uppercase;
  letter-spacing: 0.28em;
  font-size: 0.84rem;
  font-weight: 700;
  color: var(--brand-primary-dark, #d8481f);
}

.section-head h2 {
  margin: 0.6rem 0 0;
  font-size: clamp(2.2rem, 4.9vw, 4rem);
  line-height: 0.95;
  letter-spacing: -0.04em;
  color: #202328;
  font-weight: 500;
  font-family: "Space Grotesk", "IBM Plex Sans", "Segoe UI", sans-serif;
}

.section-head p {
  margin: 1.05rem 0 0;
  max-width: 56ch;
  color: #31363d;
  font-size: clamp(1.02rem, 1.1vw, 1.18rem);
  line-height: 1.55;
}

.track-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.1rem;
}

.track-card {
  border: 1px solid #e4e3e7;
  border-radius: 14px;
  background: #fcfcfc;
  padding: 1.5rem 1.4rem 1.6rem;
  box-shadow: 0 8px 18px rgba(19, 25, 38, 0.05);
  transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
}

.track-card:hover {
  transform: translateY(-4px);
  border-color: #d3d2d8;
  box-shadow: 0 16px 34px rgba(14, 20, 33, 0.08);
}

.track-index {
  display: inline-block;
  font-family: "Space Grotesk", "IBM Plex Sans", "Segoe UI", sans-serif;
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--brand-primary, #f15b30);
  letter-spacing: 0.05em;
}

.track-card h3 {
  margin: 0.6rem 0 0;
  font-family: "Space Grotesk", "IBM Plex Sans", "Segoe UI", sans-serif;
  font-size: 1.22rem;
  line-height: 1.14;
  letter-spacing: -0.01em;
  color: #14161a;
  font-weight: 600;
}

.track-card p {
  margin: 0.6rem 0 0;
  color: #555b66;
  font-size: 0.96rem;
  line-height: 1.58;
}

@media (max-width: 980px) {
  .track-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 820px) {
  .focus-areas {
    padding: 4rem 0 4.5rem;
  }

  .section-head h2 {
    font-size: clamp(2rem, 7vw, 3.2rem);
  }
}

@media (max-width: 560px) {
  .track-grid {
    grid-template-columns: 1fr;
  }

  .section-head p {
    max-width: 100%;
  }
}
</style>
