---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const strategic = partners.filter((p) => p.data.type === 'strategic');
const media = partners.filter((p) => p.data.type === 'media');
const sponsors = partners.filter((p) => p.data.type === 'sponsor');

const groups = [
  { label: 'Strategic Partners', items: strategic },
  { label: 'Media Partners', items: media },
  { label: 'Sponsors', items: sponsors },
].filter((group) => group.items.length > 0);
---

{groups.length > 0 && (
  <section id="partners" class="mx-auto max-w-6xl px-6 py-20">
    {groups.map((group) => (
      <div class="mb-12 last:mb-0">
        <p class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-accent">{group.label}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-8">
          {group.items.map((partner) => (
            <a href={partner.data.url} target="_blank" rel="noopener noreferrer" class="opacity-80 transition-opacity hover:opacity-100">
              <Image src={partner.data.logo} alt={partner.data.name} width={160} height={60} class="h-12 w-auto object-contain" />
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
)}
