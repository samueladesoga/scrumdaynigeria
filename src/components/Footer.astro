---
interface Props {
  site: {
    eventName: string;
    contactEmail: string;
    venueName: string;
    venueAddress: string;
    nav: { label: string; href: string }[];
    social: { instagram?: string; linkedin?: string; twitter?: string; facebook?: string };
  };
}

const { site } = Astro.props;
const year = new Date().getFullYear();
const socialLinks = Object.entries(site.social).filter(([, url]) => Boolean(url));
---

<footer id="contact" class="border-t border-border bg-bg-raised">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-lg font-bold text-ink">{site.eventName}</p>
        <p class="mt-2 text-sm text-ink-muted">{site.venueName}, {site.venueAddress}</p>
        <a href={`mailto:${site.contactEmail}`} class="mt-2 inline-block text-sm text-accent hover:underline">
          {site.contactEmail}
        </a>
      </div>

      <div>
        <p class="text-sm font-semibold text-ink">Quick Links</p>
        <ul class="mt-3 space-y-2">
          {site.nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-ink-muted transition-colors hover:text-ink">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {socialLinks.length > 0 && (
        <div>
          <p class="text-sm font-semibold text-ink">Follow</p>
          <ul class="mt-3 space-y-2">
            {socialLinks.map(([platform, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener noreferrer" class="text-sm capitalize text-ink-muted transition-colors hover:text-ink">
                  {platform}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <p class="mt-10 border-t border-border pt-6 text-xs text-ink-muted">
      &copy; {year} {site.eventName}. All rights reserved.
    </p>
  </div>
</footer>
