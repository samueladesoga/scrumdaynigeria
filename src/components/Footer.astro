---
interface Props {
  site: {
    eventName: string;
    venueName: string;
    venueAddress: string;
    contactEmail: string;
  };
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{site.eventName}</p>
      <p class="footer-copy">Building better products — sooner, safer, happier.</p>
    </div>

    <div>
      <p class="footer-title">Venue</p>
      <p>{site.venueName}</p>
      <p>{site.venueAddress}</p>
    </div>

    <div>
      <p class="footer-title">Links</p>
      <ul class="footer-links">
        <li><a href="/speakers">Speakers</a></li>
        <li><a href="/schedule">Schedule</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href={`mailto:${site.contactEmail}`}>Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Scrum Day Nigeria. All rights reserved.</p>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  background: var(--brand-teal-deep, #082f33);
  color: #eef1f2;
}

.footer-grid {
  padding: 2.2rem 0 1.1rem;
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 1rem;
}

.footer-brand {
  margin: 0;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.footer-copy {
  color: #b2b9bc;
  max-width: 42ch;
}

.footer-title {
  margin: 0 0 0.45rem;
  font-weight: 800;
}

.footer-links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.35rem;
}

.footer-links a {
  text-decoration: none;
  color: #b2b9bc;
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  padding: 0.95rem 0 1.3rem;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  color: #b2b9bc;
}

@media (max-width: 900px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }
}
</style>
