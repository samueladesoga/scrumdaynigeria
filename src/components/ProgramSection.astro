---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';

const days = (await getCollection('programDays')).sort((a, b) => a.data.order - b.data.order);
const site = await getEntry('site', 'config');
---

<section class="program-stage" id="program" aria-labelledby="program-title">
  <div class="program-shell container">
    <h2 id="program-title">One Day To Build Real<br />Flow And Value</h2>

    <div class="program-grid">
      {days.map((day, index) => (
        <article class="program-card day-card" style={`--card-delay: ${index * 0.08}s;`}>
          <p class="program-date">{day.data.date}</p>
          <h3>{day.data.title}</h3>
          <Image src={day.data.image} alt={day.data.title} width={800} height={480} loading="lazy" />
          <p class="program-desc">{day.data.description}</p>
          <a href={day.data.ctaHref} class="program-btn">{day.data.ctaLabel}</a>
          {(day.data.spotsLabel || day.data.priceLabel) && (
            <div class="program-meta">
              {day.data.spotsLabel && <strong>{day.data.spotsLabel}</strong>}
              {day.data.priceLabel && <span>{day.data.priceLabel}</span>}
            </div>
          )}
        </article>
      ))}
    </div>

    <a href={site?.data.ticketUrl} target="_blank" rel="noopener noreferrer" class="invite-btn">Get Tickets</a>
  </div>
</section>

<script is:inline>
  (() => {
    const stage = document.querySelector('.program-stage');
    if (!stage) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          stage.classList.add('is-visible');
          observer.disconnect();
        }
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
    );

    observer.observe(stage);
  })();
</script>

<style>
.program-stage {
  position: relative;
  overflow: hidden;
  background-color: #082f33;
  background-image: linear-gradient(180deg, #082f33 0%, #0e494f 44%, #0a3438 100%);
  background-size: 130% 130%;
  margin-top: 0;
  padding: 4.6rem 0 3.8rem;
  animation: program-gradient-shift 12.9s ease-in-out infinite alternate;
}

.program-stage::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -140px;
  transform: translateX(-50%);
  width: min(980px, 94vw);
  height: 520px;
  background: repeating-radial-gradient(ellipse at 50% 0%, rgba(218, 227, 234, 0.12) 0 1px, transparent 1px 23px);
  opacity: 0.2;
  pointer-events: none;
}

.program-stage::after {
  content: "";
  position: absolute;
  left: 0;
  top: -1px;
  width: 100%;
  height: 80px;
  background: linear-gradient(180deg, rgba(20, 35, 47, 0.98) 0%, rgba(20, 35, 47, 0.7) 48%, rgba(20, 35, 47, 0) 100%);
  pointer-events: none;
  z-index: 1;
}

@keyframes program-gradient-shift {
  0% { background-position: 0% 35%; }
  100% { background-position: 100% 65%; }
}

.program-shell {
  position: relative;
  z-index: 2;
}

.program-shell h2 {
  margin: 0 0 1.6rem;
  text-align: center;
  text-transform: uppercase;
  line-height: 0.95;
  font-size: clamp(2rem, 4.6vw, 4rem);
  color: #f2f4f7;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-weight: 500;
}

.program-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.9rem;
  max-width: 1180px;
  margin-inline: auto;
}

.program-card {
  position: relative;
  border-radius: 12px;
  padding: 1rem;
  overflow: hidden;
  opacity: 0;
  transform: translate3d(0, 20px, 0) scale(0.985);
  filter: blur(4px);
  border: 1px solid transparent;
  box-shadow: 0 14px 32px rgba(2, 8, 14, 0.16);
  will-change: transform, opacity, filter, box-shadow, border-color;
  transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 220ms ease, border-color 220ms ease;
}

.program-stage.is-visible .program-card {
  animation: premium-card-reveal 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: var(--card-delay, 0s);
}

.program-card:hover,
.program-card:focus-within {
  transform: translate3d(0, -6px, 0);
  border-color: rgba(255, 255, 255, 0.24);
  box-shadow: 0 26px 44px rgba(1, 10, 18, 0.28), 0 10px 20px rgba(1, 10, 18, 0.14);
}

.day-card {
  background: #ffffff;
  color: #212528;
  display: grid;
  grid-template-rows: auto auto auto 1fr auto auto;
}

.day-card h3 {
  margin: 0.32rem 0 0;
  font-size: clamp(1.24rem, 1.65vw, 1.84rem);
  line-height: 1.08;
  letter-spacing: -0.01em;
  text-wrap: balance;
}

.program-date {
  margin: 0;
  color: #7c8489;
  font-size: 0.92rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.program-card img {
  width: 100%;
  height: 165px;
  object-fit: cover;
  border-radius: 10px;
  margin-top: 0.7rem;
  transition: transform 260ms ease;
}

.program-card:hover img {
  transform: scale(1.03);
}

.program-desc {
  margin: 0.78rem 0 0;
  font-size: 0.96rem;
  line-height: 1.62;
  color: #3d464c;
}

.program-btn {
  position: relative;
  margin-top: 0.95rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  text-decoration: none;
  color: #f9fbff;
  background: #082f33;
  border-radius: 999px;
  padding: 0.45rem 0.9rem;
  font-weight: 700;
  transition: transform 220ms ease, box-shadow 220ms ease;
}

.program-card:hover .program-btn {
  transform: translate3d(0, -3px, 0);
  box-shadow: 0 12px 26px rgba(8, 14, 21, 0.35);
}

.program-meta {
  margin-top: 1rem;
  padding-top: 0.7rem;
  border-top: 1px dashed rgba(37, 45, 51, 0.25);
  display: grid;
  gap: 0.2rem;
}

.program-meta strong {
  font-size: 0.98rem;
  line-height: 1.35;
}

.program-meta span {
  color: #717c84;
  font-size: 0.9rem;
  line-height: 1.42;
}

.invite-btn {
  margin: 1.5rem auto 0;
  display: flex;
  width: fit-content;
  text-decoration: none;
  color: #f6f8fb;
  background: #082f33;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 999px;
  padding: 0.7rem 1.35rem;
  font-weight: 700;
}

@keyframes premium-card-reveal {
  0% { opacity: 0; transform: translate3d(0, 20px, 0) scale(0.985); filter: blur(4px); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); filter: blur(0); }
}

@media (max-width: 980px) {
  .program-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 820px;
  }
}

@media (max-width: 700px) {
  .program-grid {
    grid-template-columns: 1fr;
  }

  .program-card img {
    height: 210px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .program-card {
    opacity: 1;
    transform: none;
    filter: none;
    animation: none !important;
    transition: opacity 180ms ease;
  }
}
</style>
