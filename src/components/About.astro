---
interface Props {
  eventName: string;
}

const { eventName } = Astro.props;
---

<section id="about" class="mx-auto max-w-4xl px-6 py-20">
  <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent">About</p>
  <h2 class="mt-3 text-3xl font-bold text-ink sm:text-4xl">Building on a strong foundation</h2>
  <p class="mt-6 text-lg leading-relaxed text-ink-muted">
    Last year's {eventName} brought together 150+ product, engineering, and agile practitioners for a day of
    practical, hands-on learning. This year, we're going deeper — exploring how teams keep flow and value at the
    center of their work as AI agents take on more of the build, test, and delivery cycle.
  </p>
</section>
