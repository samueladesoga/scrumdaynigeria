---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog" description="News and updates from Scrum Day Nigeria.">
  <main class="mx-auto max-w-5xl px-6 py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent">Blog</p>
    <h1 class="mt-3 text-3xl font-bold text-ink sm:text-4xl">News & Updates</h1>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="group block overflow-hidden rounded-2xl border border-border bg-bg-card">
          <Image
            src={post.data.coverImage}
            alt={post.data.title}
            width={600}
            height={315}
            class="aspect-video w-full object-cover"
          />
          <div class="p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-accent">{post.data.category}</p>
            <h2 class="mt-2 font-semibold text-ink group-hover:text-accent">{post.data.title}</h2>
            <p class="mt-2 text-sm text-ink-muted">
              {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
          </div>
        </a>
      ))}
    </div>

    {posts.length === 0 && <p class="mt-12 text-ink-muted">No posts yet.</p>}
  </main>
</Layout>
