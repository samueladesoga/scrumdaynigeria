---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';

const site = await getEntry('site', 'config');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog" description="News and updates from Scrum Day Nigeria.">
  <Header nav={site!.data.nav} ticketUrl={site!.data.ticketUrl} />

  <main class="blog-page">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>News &amp; Updates</h1>

      <div class="post-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="post-card">
            <Image src={post.data.coverImage} alt={post.data.title} width={600} height={315} class="cover" />
            <div class="post-body">
              <p class="category">{post.data.category}</p>
              <h2>{post.data.title}</h2>
              <p class="date">
                {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && <p class="empty-note">No posts yet.</p>}
    </div>
  </main>
</Layout>

<style>
.blog-page {
  background: #f7f6f4;
  min-height: 100vh;
  padding: 3.4rem 0 4.6rem;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--brand-primary, #ff4d10);
}

h1 {
  margin: 0.4rem 0 0;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  color: #1f2429;
}

.post-grid {
  margin-top: 2.4rem;
  display: grid;
  gap: 1.4rem;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
}

.post-card {
  display: block;
  text-decoration: none;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid #e9d8c2;
  background: #fffdf9;
  box-shadow: 0 14px 28px rgba(49, 31, 21, 0.08);
  transition: transform 200ms ease, box-shadow 200ms ease;
}

.post-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 20px 36px rgba(49, 31, 21, 0.12);
}

.post-card :global(.cover) {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

.post-body {
  padding: 1.1rem 1.2rem 1.3rem;
}

.category {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--brand-primary, #ff4d10);
}

.post-body h2 {
  margin: 0.4rem 0 0;
  font-size: 1.1rem;
  color: #1f2429;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
}

.date {
  margin: 0.5rem 0 0;
  font-size: 0.85rem;
  color: #6a5f57;
}

.empty-note {
  margin-top: 2rem;
  color: #6a5f57;
}
</style>
