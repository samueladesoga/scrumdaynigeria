---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const site = await getEntry('site', 'config');
---

<Layout title={post.data.title} description={post.data.description}>
  <Header nav={site!.data.nav} ticketUrl={site!.data.ticketUrl} />

  <main class="post-page">
    <article class="container">
      <p class="category">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        &middot; {post.data.author}
      </p>

      <Image src={post.data.coverImage} alt={post.data.title} width={1200} height={630} class="cover" />

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
.post-page {
  background: #ffffff;
  min-height: 100vh;
  padding: 3.4rem 0 4.6rem;
}

.post-page .container {
  max-width: 760px;
}

.category {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--brand-primary, #f15b30);
}

h1 {
  margin: 0.4rem 0 0;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: clamp(2rem, 5vw, 3rem);
  color: #1f2429;
  line-height: 1.1;
}

.meta {
  margin: 0.6rem 0 0;
  color: #6a5f57;
  font-size: 0.9rem;
}

.cover {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 16px;
  margin-top: 2rem;
}

.prose {
  margin-top: 2rem;
  color: #2c2622;
  font-size: 1.05rem;
  line-height: 1.7;
}

.prose :global(h2),
.prose :global(h3) {
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  color: #1f2429;
}

.prose :global(a) {
  color: var(--brand-primary, #f15b30);
}
</style>
