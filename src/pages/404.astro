---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getEntry } from 'astro:content';

const site = await getEntry('site', 'config');
const { nav, ticketUrl, contactEmail, displayDate, venueName } = site!.data;
---

<Layout title="Page not found">
  <Header nav={nav} ticketUrl={ticketUrl} />

  <main class="not-found">
    <div class="container not-found-inner">
      <p class="eyebrow">Error 404</p>
      <h1>This page isn't on the agenda</h1>
      <p class="lead">
        The link may be out of date, or the page may have moved. The conference is on {displayDate} at {venueName}.
      </p>

      <div class="actions">
        <a href="/" class="action action-primary">Back to homepage</a>
        <a href={ticketUrl} class="action action-secondary">Get tickets</a>
        <a href="/schedule" class="action action-secondary">View schedule</a>
      </div>

      <p class="help">
        Still stuck? Email us at <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>
    </div>
  </main>
</Layout>

<style>
.not-found {
  background: #ffffff;
  min-height: 70vh;
  display: flex;
  align-items: center;
}

.not-found-inner {
  width: min(760px, 92%);
  padding: 4.5rem 0;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--brand-primary, #f15b30);
}

h1 {
  margin: 0.5rem 0 0;
  font-size: clamp(2.2rem, 6vw, 4rem);
  line-height: 0.98;
  letter-spacing: -0.03em;
  color: #1f2429;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
}

.lead {
  margin: 1.1rem 0 0;
  color: #4b5358;
  font-size: 1.08rem;
  max-width: 52ch;
}

.actions {
  margin-top: 1.8rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.action {
  display: inline-flex;
  align-items: center;
  padding: 0.8rem 1.3rem;
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.action-primary {
  background: var(--brand-primary, #f15b30);
  color: #ffffff;
}

.action-primary:hover {
  background: var(--brand-primary-dark, #d8481f);
}

.action-secondary {
  border: 1px solid var(--brand-teal, #0e494f);
  color: var(--brand-teal, #0e494f);
}

.action-secondary:hover {
  background: var(--brand-teal, #0e494f);
  color: #ffffff;
}

.help {
  margin: 2rem 0 0;
  color: #6a7278;
}

.help a {
  color: var(--brand-teal, #0e494f);
  font-weight: 600;
}
</style>
