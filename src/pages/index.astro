---
import Layout from '../layouts/Layout.astro';
import SectionScrollNav from '../components/SectionScrollNav.vue';
import Hero from '../components/Hero.vue';
import StageIntro from '../components/StageIntro.astro';
import FocusAreasSection from '../components/FocusAreasSection.astro';
import ProgramSection from '../components/ProgramSection.astro';
import SpeakersShowcase from '../components/SpeakersShowcase.astro';
import PartnersShowcase from '../components/PartnersShowcase.astro';
import TestimonialsMarquee from '../components/TestimonialsMarquee.astro';
import VenueCarousel from '../components/VenueCarousel.astro';
import TicketsSection from '../components/TicketsSection.vue';
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';

const site = await getEntry('site', 'config');
if (!site) throw new Error('Missing site config entry (src/content/site.yaml)');
const { data } = site;

// Partners flagged `hero: true` get their logo in the hero's "In partnership with" row.
const heroPartners = await Promise.all(
  (await getCollection('partners'))
    .filter((p) => p.data.hero)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (p) => {
      const logo = await getImage({ src: p.data.logo, height: 80 });
      return { name: p.data.name, url: p.data.url, logo: logo.src, background: p.data.background };
    })
);

const ticketTiers = (await getCollection('ticketTiers')).sort((a, b) => a.data.order - b.data.order);
// Early bird runs through the whole of its `until` day in Lagos (UTC+1), i.e. ends at 23:00 UTC.
const LAGOS_END_OF_DAY_MS = 23 * 60 * 60 * 1000;
const tierProps = ticketTiers.map((t) => ({
  id: t.id,
  ...t.data,
  bands: t.data.bands?.map(({ earlyBird, ...band }) => ({
    ...band,
    earlyBird: earlyBird && {
      price: earlyBird.price,
      url: earlyBird.url,
      endsAt: earlyBird.until.getTime() + LAGOS_END_OF_DAY_MS,
    },
  })),
}));

// Drop event photos into src/assets/hero-marquee/ to have them picked up here automatically.
// Resized/re-encoded here (instead of imported raw into Hero.vue) since the marquee only ever
// displays them at ~320px wide — the source photos were full camera resolution (2.7-4.2MB each).
const marqueeModules = import.meta.glob('../assets/hero-marquee/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const marqueeImages = await Promise.all(
  Object.keys(marqueeModules)
    .sort()
    .map(async (path) => {
      const optimized = await getImage({
        src: marqueeModules[path],
        width: 640,
        widths: [320, 640],
        format: 'webp',
        quality: 68,
      });
      return { src: optimized.src, srcset: optimized.srcSet.attribute };
    })
);
---

<Layout title="Home">
  <SectionScrollNav client:load nav={data.nav} ticketUrl={data.ticketUrl} />
  <main>
    <Hero
      client:load
      displayDate={data.displayDate}
      venueName={data.venueName}
      venueAddress={data.venueAddress}
      theme={data.theme}
      ticketUrl={data.ticketUrl}
      heroPartners={heroPartners}
      partnersNote={data.heroPartnersNote}
      expectedParticipants={data.metrics.expectedParticipants}
      marqueeImages={marqueeImages}
    />
    <StageIntro />
    <FocusAreasSection />
    <ProgramSection />
    <SpeakersShowcase />
    <PartnersShowcase />
    <TestimonialsMarquee />
    <VenueCarousel />
    <TicketsSection
      client:load
      tiers={tierProps}
      included={data.ticketsIncluded}
      contactEmail={data.contactEmail}
      eventName={data.eventName}
      renderedAt={Date.now()}
    />
  </main>
</Layout>
